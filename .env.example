# AgriVision AI Environment Configuration Example

# Environment Mode
AGRIVISION_ENV=development
DEBUG=True

# Application Secrets & Security
SECRET_KEY=generate_a_secure_random_key_here_for_jwt_and_sessions
API_KEY=local-dev-secret-api-key
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Database Configuration (PostgreSQL 15 + PostGIS)
DATABASE_URL=postgresql://agrivision_user:agrivision_password@localhost:5432/agrivision
POSTGRES_USER=agrivision_user
POSTGRES_PASSWORD=agrivision_password
POSTGRES_DB=agrivision
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Cache & Message Broker
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Object Storage (MinIO / S3 compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=agrivision-storage
S3_REGION=us-east-1
S3_SECURE=False

# Weather & Agro-Climatic Intelligence API
WEATHER_API_KEY=your_weather_provider_api_key_here
WEATHER_API_URL=https://api.weatherapi.com/v1

# AI & Model Serving Configurations
DEVICE=auto
MAX_UPLOAD_SIZE_MB=15
TROCR_MODEL_NAME=microsoft/trocr-base-handwritten
PLANT_DISEASE_MODEL_PATH=ai/weights/plant_disease_resnet50.onnx
PEST_DETECTION_MODEL_PATH=ai/weights/pest_yolo.onnx

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=agrivision-field-trials

# Telemetry & Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
